<%- include('includes/head') %> <%- include('includes/nav') %>

<div class="container-fluid">
  <!-- Hero Section -->
  <div
    class="row mb-5 py-5"
    style="
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border-radius: 10px;
    "
  >
    <div class="col-12 col-md-6 d-flex flex-column justify-content-center">
      <h1 class="display-3 fw-bold mb-4">Sua Agenda de Contatos</h1>
      <p class="lead mb-4">
        Organize, gerencie e mantenha contato com as pessoas que importam.
        Simples, rápido e eficiente.
      </p>
      <div>
        <a href="/contato/criar" class="btn btn-light btn-lg me-3 fw-bold"
          >Criar Novo Contato</a
        >
        <a href="#features" class="btn btn-outline-light btn-lg fw-bold"
