    <div class="col-md-3 mb-3 text-center">
      <h3 class="display-5 fw-bold text-success">0</h3>
      <p class="text-muted">Novos esta semana</p>
    </div>
    <div class="col-md-3 mb-3 text-center">
      <h3 class="display-5 fw-bold text-info">0</h3>
      <p class="text-muted">Contatos com email</p>
    </div>
    <div class="col-md-3 mb-3 text-center">
      <h3 class="display-5 fw-bold text-warning">100%</h3>
      <p class="text-muted">Taxa de utilização</p>
